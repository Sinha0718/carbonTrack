# Copy to .env and adjust. Never commit real secrets.
DB_URL=jdbc:postgresql://localhost:5432/carbontrack
DB_USERNAME=carbontrack
DB_PASSWORD=carbontrack

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=PT24H

# Optional: creates an ADMIN user on startup if it does not exist
ADMIN_EMAIL=admin@carbontrack.local
ADMIN_PASSWORD=ChangeMe123!

# Optional Google OAuth2 (activate with SPRING_PROFILES_ACTIVE=oauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
