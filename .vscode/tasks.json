{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CarbonTrack (demo)",
      "type": "shell",
      "command": "./mvnw spring-boot:run -Dspring-boot.run.profiles=demo",
      "windows": { "command": ".\\mvnw.cmd spring-boot:run \"-Dspring-boot.run.profiles=demo\"" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "./mvnw test",
      "windows": { "command": ".\\mvnw.cmd test" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
